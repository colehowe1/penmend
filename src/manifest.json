{
  "manifest_version": 3,
  "name": "Penmend",
  "short_name": "Penmend",
  "version": "1.1.1",
  "description": "Spelling, grammar and clearer sentences in any text box. Free, private local checks, plus optional AI checks with your own key.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Penmend",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "highlights.css"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open the Penmend panel for the text box you're in"
    },
    "rewrite-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Rewrite the selected text with Claude"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
